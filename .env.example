# Copy to .env for local development (never commit .env). On Render, set these in the dashboard instead.

# --- Paddle (buying points) ---
# "sandbox" for testing, "production" for real payments. Picks api.paddle.com vs sandbox-api.paddle.com
# and whether Paddle.js runs in sandbox mode, so keys and prices must come from the same environment.
PADDLE_ENV=sandbox
# Server-side API key (Developer tools > Authentication). Secret.
PADDLE_API_KEY=
# Client-side token: test_… in sandbox, live_… in production. Public.
PADDLE_CLIENT_TOKEN=
# Secret key of the notification destination pointed at https://<your site>/api/shop/paddle-webhook
# (events: transaction.paid, transaction.completed). Secret.
PADDLE_WEBHOOK_SECRET=
# Each point pack's Paddle price id, from the same environment as the keys above.
PADDLE_PRICES=p50=pri_...,p100=pri_...,p200=pri_...,p400=pri_...,p1000=pri_...

# --- Accounts (Supabase; without these, accounts are saved to ./data) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Email verification codes (Resend; without a key nothing is sent and every account counts as verified) ---
RESEND_API_KEY=
MAIL_FROM=Doodlz <noreply@doodlz.io>

# --- Shown in the footer, Contact page and policies (build time) ---
VITE_BUSINESS_NAME=
VITE_BUSINESS_ADDRESS=
VITE_CONTACT_EMAIL=support@doodlz.io
