{
  "name": "doodlz-gg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "doodlz.gg — real-time multiplayer drawing & guessing game",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "SERVER_PORT=3001 ALLOW_SAME_DEVICE=1 RANKED_UNIQUE_IP=0 tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p server/tsconfig.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
